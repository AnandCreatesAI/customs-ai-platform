# Django Configuration
SECRET_KEY=generate-a-unique-django-secret-key
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL
DB_NAME=customs_ai_platform
DB_USER=customs_ai_user
DB_PASSWORD=customs_ai_dev_password
DB_HOST=127.0.0.1
DB_PORT=5433

# Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite

# Document Storage
DOCUMENT_STORAGE_ROOT=
DOCUMENT_STORAGE_BACKEND=django.core.files.storage.FileSystemStorage
TRAINING_MAX_FILE_SIZE_BYTES=26214400
TRAINING_TEXT_MAX_CHARS=500000
TRAINING_JSON_MAX_CHARS=500000
TRAINING_JOB_MAX_RETRIES=3

# Redis and Celery
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_AUTO_START_WORKER=True
CELERY_DEV_WORKER_LOGLEVEL=info
CELERY_DEV_WORKER_POOL=solo
CELERY_DEV_WORKER_CONCURRENCY=1
CELERY_TASK_ALWAYS_EAGER=False
CELERY_TASK_TIME_LIMIT=1800
CELERY_TASK_SOFT_TIME_LIMIT=1500
CELERY_WORKER_PREFETCH_MULTIPLIER=1
TRAINING_JOB_STALE_PROCESSING_SECONDS=1800
TRAINING_JOB_CELERY_MAX_RETRIES=3

# Document Extraction
EXTRACTION_STORAGE_ROOT=
EXTRACTION_USE_MOCK_OCR=false
EXTRACTION_OCR_LANGUAGE=eng
EXTRACTION_OCR_MIN_CONFIDENCE=0.35
EXTRACTION_MAX_ELEMENTS=50000
EXTRACTION_MAX_ARTIFACT_BYTES=26214400
EXTRACTION_LIBREOFFICE_BINARY=soffice
EXTRACTION_LIBREOFFICE_TIMEOUT_SECONDS=120
EXTRACTION_OCR_TIMEOUT_SECONDS=60
EXTRACTION_PDF_NATIVE_MIN_CHARS=32
VISION_ENABLED=false

# Document Chunking
CHUNKING_VERSION=1.0.0
CHUNKING_PROSE_TARGET_TOKENS=512
CHUNKING_PROSE_MIN_TOKENS=50
CHUNKING_PROSE_MAX_TOKENS=800
CHUNKING_PROSE_OVERLAP_TOKENS=75
CHUNKING_MAX_CHUNKS_PER_DOCUMENT=0
CHUNKING_TOKENIZER_PROVIDER=tiktoken
CHUNKING_TOKENIZER_ENCODING=cl100k_base
CHUNKING_SPREADSHEET_MIN_ROWS=1
CHUNKING_SPREADSHEET_MAX_ROWS=20
CHUNKING_JSON_MAX_TOKENS=800
CHUNKING_DB_BATCH_SIZE=500

# Gemini Semantic Embeddings
EMBEDDING_PROVIDER=gemini
EMBEDDING_ALLOW_EXTERNAL=true
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_MAX_RETRIES=3
EMBEDDING_MAX_INPUT_TOKENS=2048
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSION=1536
GEMINI_EMBEDDING_MAX_INPUT_TOKENS=2048

# Qdrant Vector Database
QDRANT_URL=https://158890c7-1145-423f-9c88-74dac787e084.australia-southeast1-0.gcp.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION_PREFIX=customs_ai
QDRANT_TIMEOUT_SECONDS=30
QDRANT_UPSERT_BATCH_SIZE=32
QDRANT_MAX_RETRIES=3
QDRANT_RETRY_BACKOFF_SECONDS=2
QDRANT_INDEXING_ENABLED=true

# Semantic Retrieval
RETRIEVAL_ENABLED=true
RETRIEVAL_MAX_QUERY_LENGTH=4000
RETRIEVAL_DEFAULT_TOP_K=8
RETRIEVAL_MIN_TOP_K=1
RETRIEVAL_MAX_TOP_K=50
RETRIEVAL_DEFAULT_MIN_SCORE=0
RETRIEVAL_OVERFETCH_MULTIPLIER=3
RETRIEVAL_SEARCH_MAX_BATCHES=5
RETRIEVAL_MAX_CONTEXT_CHUNKS=20
RETRIEVAL_MAX_CONTEXT_CHARACTERS=50000
RETRIEVAL_SCORE_SEMANTICS=qdrant_cosine_similarity

# RAG Answer Generation
RAG_ENABLED=true
RAG_FAIL_CLOSED=true
RAG_CHAT_TOP_K=8
RAG_CHAT_MIN_SCORE=0

# Chatbot and Public Chat
CHATBOT_REQUEST_TIMEOUT_SECONDS=90
PUBLIC_CHAT_ENABLED=true
PUBLIC_CHAT_THROTTLE=60/hour
PUBLIC_CHAT_MAX_MESSAGE_LENGTH=4000

# Optional CORS for split frontend development
# DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
