# PostgreSQL (Docker Compose + Django)
# Copy to .env and set real values locally. Never commit .env.

DB_NAME=customs_ai_platform
DB_USER=customs_ai_user
DB_PASSWORD=your_password_here
DB_HOST=127.0.0.1
DB_PORT=5432

# Google Gemini (set GEMINI_API_KEY locally; never commit .env)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
